#version 450
#extension GL_GOOGLE_include_directive : require
// UPSCALING: FSR 1 (AMD FidelityFX Super Resolution 1.0.2, MIT, gpu/third_party/fidelityfx_fsr1): the picture
// drawn smaller than the window brought up to it in two passes - built with -DEASU, the edge-adaptive upscale
// from `source` (the picture, `in_view` of its `in_size` pixels) to `result` (`out_size`); with -DRCAS, the
// sharpening of EASU's result, `sharpness` stops below the most. 32-bit floats throughout (no 16-bit types:
// every Vulkan 1.3 device, Android's too). Constants worked out here (FsrEasuCon, FsrRcasCon run on the GPU
// as on the CPU): the same for every pixel, hoisted by the compiler. Groups of 64 threads, 16 x 16 pixels
// (AMD's sample: ARmp8x8 and four pixels a thread).

layout(local_size_x = 64) in;
layout(set = 0, binding = 0) uniform sampler2D source;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D result;
layout(push_constant) uniform Params {
    vec2 in_view;       // the picture's pixels in `source`
    vec2 in_size;       // `source`'s size
    vec2 out_size;      // `result`'s
    float sharpness;    // RCAS: stops below the most sharpening (0)
} p;

#define A_GPU 1
#define A_GLSL 1
#include "ffx_a.h"

#ifdef EASU
#define FSR_EASU_F 1
AF4 FsrEasuRF(AF2 at) { return textureGather(source, at, 0); }
AF4 FsrEasuGF(AF2 at) { return textureGather(source, at, 1); }
AF4 FsrEasuBF(AF2 at) { return textureGather(source, at, 2); }
#else
#define FSR_RCAS_F 1
AF4 FsrRcasLoadF(ASU2 at) { return texelFetch(source, at, 0); }
void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}
#endif
#include "ffx_fsr1.h"

void Filter(AU2 at) {
    if (at.x >= AU1(p.out_size.x) || at.y >= AU1(p.out_size.y)) return;
#ifdef EASU
    AU4 con0, con1, con2, con3;
    FsrEasuCon(con0, con1, con2, con3, p.in_view.x, p.in_view.y, p.in_size.x, p.in_size.y, p.out_size.x,
               p.out_size.y);
    AF3 c;
    FsrEasuF(c, at, con0, con1, con2, con3);
    imageStore(result, ASU2(at), AF4(c, 1.0));
#else
    AU4 con;
    FsrRcasCon(con, p.sharpness);
    AF1 r, g, b;
    FsrRcasF(r, g, b, at, con);
    imageStore(result, ASU2(at), AF4(r, g, b, 1.0));
#endif
}

void main() {
    AU2 at = ARmp8x8(gl_LocalInvocationID.x) + AU2(gl_WorkGroupID.x << 4u, gl_WorkGroupID.y << 4u);
    Filter(at);
    at.x += 8u;
    Filter(at);
    at.y += 8u;
    Filter(at);
    at.x -= 8u;
    Filter(at);
}
